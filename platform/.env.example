# Pubbblic dedicated Supabase project -> Connect -> Frameworks (Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PUBBBLIC_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PROJECT_KEY

# Supabase Auth -> URL Configuration
# Site URL: https://app.pubbblic.com (after authorized production launch)
# Allowed redirect URLs: https://<your-actual-vercel-preview>/auth/callback and any approved staging origin
# Email -> Magic Link template: include {{ .Token }} if you want code entry; magic link callback also supported.
# Do not set a Supabase secret/service key in this browser-facing app.
# DeepSeek and Zyte remain deliberately disabled until separate gates.
