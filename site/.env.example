# Required for secure waitlist collection (never NEXT_PUBLIC_ these)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SET_IN_VERCEL
# Required for automated opt-in welcome + drip emails
RESEND_API_KEY=SET_IN_VERCEL
RESEND_FROM=Pubbblic <updates@pubbblic.com>
CRON_SECRET=SET_A_LONG_RANDOM_VALUE
UNSUBSCRIBE_SIGNING_SECRET=SET_A_SEPARATE_LONG_RANDOM_VALUE
NEXT_PUBLIC_SITE_URL=https://pubbblic.com
# Set to true after launch to stop prelaunch drip messages
WAITLIST_LAUNCHED=false
